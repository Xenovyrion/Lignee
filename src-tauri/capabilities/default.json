{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de Lignée : sauvegarde dans AppData, export et import vers un fichier choisi par l'utilisateur",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
