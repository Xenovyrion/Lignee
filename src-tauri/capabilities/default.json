{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de Lignée : sauvegarde dans AppData, export et import vers un fichier choisi par l'utilisateur, mode compagnon (fenêtre compacte au premier plan)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:allow-save",
    "dialog:allow-open",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize"
  ]
}
