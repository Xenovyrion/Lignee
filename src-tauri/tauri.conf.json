{
  "productName": "Lignée",
  "version": "1.0.6",
  "identifier": "io.github.xenovyrion.lignee",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Lignée", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 600, "center": true }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NDNDNDk0NDM0MDE1QzMKUldUREZVQkRsTVJEdUIyNXduNnhkUUtHa1hCOGs3NTNGdmpxaWNBdm04WlN6RjJNdFBYRkJFM0UK",
      "endpoints": ["https://github.com/Xenovyrion/Lignee/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
